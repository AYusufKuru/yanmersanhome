# Site adresi. Canlı ortamda gerçek alan adıyla değiştirilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Yerelde `npx prisma dev` çıktısındaki adresler.
# Canlıda Vercel ortam değişkenine gerçek bağlantı yazılır. Bu dosyaya şifre konmaz.
DATABASE_URL=
SHADOW_DATABASE_URL=

# Oturum pepper'ı. En az 32 karakter. Kaynak koda yazılmaz.
AUTH_SECRET=

# İlk yönetici. `npm run db:seed` oluşturur. Şifre en az 12 karakter, harf ve rakam içerir.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici
