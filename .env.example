# Site adresi. Canlı ortamda gerçek alan adıyla değiştirilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Yerelde `npx prisma dev` çıktısındaki adresler.
# Canlıda Vercel ortam değişkenine gerçek bağlantı yazılır. Bu dosyaya şifre konmaz.
DATABASE_URL=
SHADOW_DATABASE_URL=

# Oturum pepper'ı. En az 32 karakter. Kaynak koda yazılmaz.
AUTH_SECRET=

# İlk yönetici. `npm run db:seed` oluşturur. Şifre en az 12 karakter, harf ve rakam içerir.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici

# Ödeme. mock test ekranıdır, para çekmez. iyzico ve PayTR anahtarsız tahsilat açmaz.
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# E-posta. Boşken şifre sıfırlama mektubu gitmez.
# Değerin içinde # varsa satırı tırnak içine alın: SMTP_PASSWORD="sifre#123"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Analitik. Boşken dış istek gitmez. Çerez izni olmadan da yüklenmez.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
